-- GoKesari: copy shops from test.gokesari.com to gokesari.com (production)
-- __TITLE__
-- Shops: __SHOPS__ · test export of __EXPORTED__
--
-- HOW TO RUN: Neon console → the PRODUCTION project (gokesari.com) → SQL
-- Editor → database neondb → paste this whole file → Run.
-- __MODE_NOTE__
--
-- The result lists what happened to each shop. Any error leaves production
-- exactly as it was. Running it again copies nothing twice: a shop already on
-- production (same id, or the same name in the same PIN code, or the same
-- Shop Act registration) is skipped.
--
-- Generated by scripts/copy-shops/to-sql.ts (docs/copy-shops-2026-10/README.md),
-- with the same rules as the "Copy shops to production" workflow: owners matched
-- by e-mail or phone (else created) and given the shop-owner role, a NEW
-- registration number from production's sequence, products matched to
-- production's catalogue by id, barcode or exact name/size (else added with a
-- new product code), prices, stock, categories and photos. Never orders,
-- payments, wallets, invoices, sessions, admin roles, or anything encrypted
-- with the test site's keys (PAN number, legal-document files).

DROP TABLE IF EXISTS cs_bundle;
CREATE TEMP TABLE cs_bundle AS SELECT $cs_json__TAG__$__BUNDLE__$cs_json__TAG__$::jsonb AS j;
CREATE TEMP TABLE IF NOT EXISTS cs_report (n serial PRIMARY KEY, line text);
TRUNCATE cs_report;
CREATE TEMP TABLE IF NOT EXISTS cs_log (n serial PRIMARY KEY, line text);
TRUNCATE cs_log;
CREATE TEMP TABLE IF NOT EXISTS cs_counts (k text PRIMARY KEY, v int NOT NULL);
TRUNCATE cs_counts;
CREATE TEMP TABLE IF NOT EXISTS cs_map (kind text, src text, dst text, added boolean NOT NULL DEFAULT false, PRIMARY KEY (kind, src));
TRUNCATE cs_map;
CREATE TEMP TABLE IF NOT EXISTS cs_missing (id text PRIMARY KEY);
TRUNCATE cs_missing;
CREATE TEMP TABLE IF NOT EXISTS cs_seq (kind text PRIMARY KEY, next bigint NOT NULL);
TRUNCATE cs_seq;

CREATE OR REPLACE FUNCTION pg_temp.cs_rows(name text) RETURNS SETOF jsonb LANGUAGE sql AS $f$
  SELECT jsonb_array_elements(coalesce(j->'rows'->name, '[]'::jsonb)) FROM cs_bundle;
$f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_row(name text, p_id text) RETURNS jsonb LANGUAGE sql AS $f$
  SELECT e FROM pg_temp.cs_rows(name) e WHERE e->>'id' = p_id LIMIT 1;
$f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_say(p_line text) RETURNS void LANGUAGE sql AS $f$
  INSERT INTO cs_log (line) VALUES (p_line);
$f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_bump(p_key text, p_by int DEFAULT 1) RETURNS void LANGUAGE sql AS $f$
  INSERT INTO cs_counts (k, v) VALUES (p_key, p_by) ON CONFLICT (k) DO UPDATE SET v = cs_counts.v + p_by;
$f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_count(p_key text) RETURNS int LANGUAGE sql AS $f$
  SELECT coalesce((SELECT c.v FROM cs_counts c WHERE c.k = p_key), 0);
$f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_dst(p_kind text, p_src text) RETURNS text LANGUAGE sql AS $f$
  SELECT dst FROM cs_map WHERE kind = p_kind AND src = p_src;
$f$;

-- The next value of a sequence: taken when saving, only predicted in the
-- preview (a sequence never rolls back, so the preview must not use it up).
CREATE OR REPLACE FUNCTION pg_temp.cs_next(p_kind text, p_apply boolean) RETURNS bigint LANGUAGE plpgsql AS $f$
DECLARE n bigint;
BEGIN
  IF p_apply THEN
    RETURN nextval(CASE p_kind WHEN 'reg' THEN 'shop_registration_seq' ELSE 'product_code_seq' END);
  END IF;
  UPDATE cs_seq SET next = next + 1 WHERE kind = p_kind RETURNING next - 1 INTO n;
  RETURN n;
END $f$;

-- A stored photo (with its smaller copies) unless production has it; false when the export has no bytes for it.
CREATE OR REPLACE FUNCTION pg_temp.cs_image(p_id text) RETURNS boolean LANGUAGE plpgsql AS $f$
DECLARE r jsonb;
BEGIN
  IF EXISTS (SELECT 1 FROM stored_images WHERE id::text = p_id) THEN RETURN true; END IF;
  r := pg_temp.cs_row('stored_images', p_id);
  IF r IS NULL THEN
    INSERT INTO cs_missing (id) VALUES (p_id) ON CONFLICT DO NOTHING;
    RETURN false;
  END IF;
  INSERT INTO stored_images SELECT * FROM jsonb_populate_record(NULL::stored_images,
    r || jsonb_build_object('owner_id', pg_temp.cs_dst('user', r->>'owner_id')));
  INSERT INTO stored_image_variants
    SELECT p.* FROM pg_temp.cs_rows('stored_image_variants') e, LATERAL jsonb_populate_record(NULL::stored_image_variants, e) p
    WHERE e->>'stored_image_id' = p_id;
  PERFORM pg_temp.cs_bump('images');
  RETURN true;
END $f$;

-- An image URL on production: kept when every photo it points to came across, else dropped.
CREATE OR REPLACE FUNCTION pg_temp.cs_url(p_url text) RETURNS text LANGUAGE plpgsql AS $f$
DECLARE m text[];
BEGIN
  IF p_url IS NULL OR p_url = '' THEN RETURN NULL; END IF;
  FOR m IN SELECT regexp_matches(p_url, '/api/images/([0-9a-fA-F-]{36})', 'g') LOOP
    IF NOT pg_temp.cs_image(lower(m[1])) THEN RETURN NULL; END IF;
  END LOOP;
  RETURN p_url;
END $f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_owner(p_src text) RETURNS text LANGUAGE plpgsql AS $f$
DECLARE u jsonb; t text; t_role text; t_email text; n int;
BEGIN
  t := pg_temp.cs_dst('user', p_src);
  IF t IS NOT NULL THEN RETURN t; END IF;
  u := pg_temp.cs_row('users', p_src);
  IF u IS NULL THEN RAISE EXCEPTION 'Owner % is missing from the export.', p_src; END IF;
  SELECT id::text, role::text, email INTO t, t_role, t_email FROM users WHERE id::text = p_src;
  IF t IS NOT NULL AND lower(t_email) <> lower(u->>'email') THEN
    RAISE EXCEPTION 'User id % exists on production with a different e-mail. Nothing was changed.', p_src;
  END IF;
  IF t IS NULL AND NOT coalesce((u->>'email_placeholder')::boolean, false) THEN
    SELECT id::text, role::text INTO t, t_role FROM users WHERE lower(email) = lower(u->>'email') AND deleted_at IS NULL LIMIT 1;
  END IF;
  IF t IS NULL AND u->>'phone_e164' IS NOT NULL THEN
    SELECT id::text, role::text INTO t, t_role FROM users WHERE phone_e164 = u->>'phone_e164' AND deleted_at IS NULL LIMIT 1;
  END IF;
  IF t IS NOT NULL THEN
    PERFORM pg_temp.cs_bump('existing_owners');
    PERFORM pg_temp.cs_say(format('  - Owner %s: existing production account (role %s%s)', u->>'name', t_role,
      CASE WHEN t_role = 'CUSTOMER' THEN ', now also shop owner' ELSE '' END));
  ELSE
    t := p_src;
    -- A shop owner on production, whatever they were on test (test admins stay test admins).
    INSERT INTO users SELECT * FROM jsonb_populate_record(NULL::users,
      u || jsonb_build_object('role', 'SHOP_OWNER', 'deleted_at', NULL, 'updated_at', now()));
    -- Terms the owner accepted, as evidence on production too.
    INSERT INTO user_consents
      SELECT p.* FROM pg_temp.cs_rows('user_consents') e, LATERAL jsonb_populate_record(NULL::user_consents, e) p
      WHERE e->>'user_id' = p_src;
    GET DIAGNOSTICS n = ROW_COUNT;
    PERFORM pg_temp.cs_bump('new_owners');
    PERFORM pg_temp.cs_say(format('  - Owner %s: new production account (%s consent record(s) kept)', u->>'name', n));
  END IF;
  INSERT INTO user_role_grants (user_id, role, status, source)
    VALUES (t::uuid, 'SHOP_OWNER', 'ACTIVE', 'BACKFILL')
  ON CONFLICT (user_id, role) DO UPDATE SET status = 'ACTIVE', revoked_by = NULL, revoked_at = NULL
    WHERE user_role_grants.status <> 'ACTIVE';
  UPDATE users SET role = 'SHOP_OWNER', updated_at = now() WHERE id::text = t AND role = 'CUSTOMER';
  INSERT INTO cs_map (kind, src, dst) VALUES ('user', p_src, t);
  RETURN t;
END $f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_pcat(p_src text) RETURNS text LANGUAGE plpgsql AS $f$
DECLARE c jsonb; t text;
BEGIN
  t := pg_temp.cs_dst('pcat', p_src);
  IF t IS NOT NULL THEN RETURN t; END IF;
  c := pg_temp.cs_row('product_categories', p_src);
  IF c IS NULL THEN RAISE EXCEPTION 'Product category % is missing from the export.', p_src; END IF;
  SELECT id::text INTO t FROM product_categories WHERE id::text = p_src;
  IF t IS NULL THEN SELECT id::text INTO t FROM product_categories WHERE slug = c->>'slug'; END IF;
  IF t IS NULL THEN SELECT id::text INTO t FROM product_categories WHERE lower(name) = lower(c->>'name') AND deleted_at IS NULL LIMIT 1; END IF;
  IF t IS NULL THEN
    INSERT INTO product_categories SELECT * FROM jsonb_populate_record(NULL::product_categories,
      c || '{"is_system": false, "created_by": null, "deleted_at": null}'::jsonb);
    t := p_src;
    PERFORM pg_temp.cs_bump('categories');
    PERFORM pg_temp.cs_say(format('  - product category "%s" added', c->>'name'));
  END IF;
  INSERT INTO cs_map (kind, src, dst) VALUES ('pcat', p_src, t);
  RETURN t;
END $f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_subcat(p_src text) RETURNS text LANGUAGE plpgsql AS $f$
DECLARE c jsonb; t text;
BEGIN
  IF p_src IS NULL THEN RETURN NULL; END IF;
  t := pg_temp.cs_dst('subcat', p_src);
  IF t IS NOT NULL THEN RETURN t; END IF;
  c := pg_temp.cs_row('product_subcategories', p_src);
  IF c IS NULL THEN RAISE EXCEPTION 'Product subcategory % is missing from the export.', p_src; END IF;
  SELECT id::text INTO t FROM product_subcategories WHERE id::text = p_src;
  IF t IS NULL THEN SELECT id::text INTO t FROM product_subcategories WHERE slug = c->>'slug'; END IF;
  IF t IS NULL THEN
    INSERT INTO product_subcategories SELECT * FROM jsonb_populate_record(NULL::product_subcategories,
      c || jsonb_build_object('category_id', pg_temp.cs_pcat(c->>'category_id'), 'deleted_at', NULL));
    t := p_src;
  END IF;
  INSERT INTO cs_map (kind, src, dst) VALUES ('subcat', p_src, t);
  RETURN t;
END $f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_brand(p_src text) RETURNS text LANGUAGE plpgsql AS $f$
DECLARE c jsonb; t text;
BEGIN
  IF p_src IS NULL THEN RETURN NULL; END IF;
  t := pg_temp.cs_dst('brand', p_src);
  IF t IS NOT NULL THEN RETURN t; END IF;
  c := pg_temp.cs_row('brands', p_src);
  IF c IS NULL THEN RAISE EXCEPTION 'Brand % is missing from the export.', p_src; END IF;
  SELECT id::text INTO t FROM brands WHERE id::text = p_src;
  IF t IS NULL THEN SELECT id::text INTO t FROM brands WHERE slug = c->>'slug'; END IF;
  IF t IS NULL THEN
    INSERT INTO brands SELECT * FROM jsonb_populate_record(NULL::brands, c || '{"created_by": null, "deleted_at": null}'::jsonb);
    t := p_src;
  END IF;
  INSERT INTO cs_map (kind, src, dst) VALUES ('brand', p_src, t);
  RETURN t;
END $f$;

-- A photo row: kept when its stored photo and URL came across.
CREATE OR REPLACE FUNCTION pg_temp.cs_photo(x jsonb) RETURNS boolean LANGUAGE plpgsql AS $f$
DECLARE u text;
BEGIN
  IF x->>'stored_image_id' IS NOT NULL AND NOT pg_temp.cs_image(x->>'stored_image_id') THEN RETURN false; END IF;
  u := pg_temp.cs_url(x->>'url');
  IF u IS NULL THEN RETURN false; END IF;
  INSERT INTO product_images SELECT * FROM jsonb_populate_record(NULL::product_images, x || jsonb_build_object(
    'product_id', coalesce(pg_temp.cs_dst('product', x->>'product_id'), x->>'product_id'),
    'url', u, 'created_by', NULL, 'moderated_by', NULL));
  RETURN true;
END $f$;

CREATE OR REPLACE FUNCTION pg_temp.cs_product(p_src text, p_apply boolean) RETURNS text LANGUAGE plpgsql AS $f$
DECLARE p jsonb; t text; cat text; slug_v text; x jsonb;
BEGIN
  t := pg_temp.cs_dst('product', p_src);
  IF t IS NOT NULL THEN RETURN t; END IF;
  p := pg_temp.cs_row('products', p_src);
  IF p IS NULL THEN RAISE EXCEPTION 'Product % is missing from the export.', p_src; END IF;
  cat := pg_temp.cs_pcat(p->>'category_id');
  SELECT id::text INTO t FROM products WHERE id::text = p_src;
  IF t IS NULL AND p->>'gtin' IS NOT NULL THEN
    SELECT id::text INTO t FROM products WHERE gtin = p->>'gtin' AND deleted_at IS NULL LIMIT 1;
  END IF;
  IF t IS NULL THEN
    SELECT CASE WHEN count(*) = 1 THEN min(id::text) END INTO t FROM products
    WHERE deleted_at IS NULL AND lower(name) = lower(p->>'name')
      AND coalesce(lower(variant), '') = coalesce(lower(p->>'variant'), '')
      AND unit::text = p->>'unit' AND unit_size_milli::text = p->>'unit_size_milli' AND category_id::text = cat;
  END IF;
  IF t IS NOT NULL THEN
    INSERT INTO cs_map (kind, src, dst, added) VALUES ('product', p_src, t, false);
    PERFORM pg_temp.cs_bump('matched_products');
    RETURN t;
  END IF;
  slug_v := p->>'slug';
  IF EXISTS (SELECT 1 FROM products WHERE slug = slug_v) THEN slug_v := slug_v || '-' || substr(md5(random()::text), 1, 6); END IF;
  INSERT INTO products SELECT * FROM jsonb_populate_record(NULL::products, p || jsonb_build_object(
    'code', 'P' || lpad(pg_temp.cs_next('code', p_apply)::text, 5, '0'),
    'slug', slug_v,
    'category_id', cat,
    'subcategory_id', pg_temp.cs_subcat(p->>'subcategory_id'),
    'brand_id', pg_temp.cs_brand(p->>'brand_id'),
    'image_url', pg_temp.cs_url(p->>'image_url'),
    'created_by', NULL, 'approved_by', NULL, 'deleted_at', NULL));
  INSERT INTO cs_map (kind, src, dst, added) VALUES ('product', p_src, p_src, true);
  -- The product's own catalogue photos (not a listing's).
  FOR x IN SELECT e FROM pg_temp.cs_rows('product_images') e WHERE e->>'product_id' = p_src AND e->>'shop_product_id' IS NULL LOOP
    PERFORM pg_temp.cs_photo(x);
  END LOOP;
  PERFORM pg_temp.cs_bump('new_products');
  RETURN p_src;
END $f$;

DO $cs_body$
DECLARE
  apply constant boolean := __APPLY__;
  b jsonb;
  rep text[];
  s jsonb; x jsonb; y jsonb;
  t text; t2 text; v_owner text; reg text; slug_v text; photos jsonb;
  n_list int; n_new int; n_photos int; n_chosen int; n_rows int;
  c_shops int; c_skipped int;
BEGIN
  SELECT j INTO b FROM cs_bundle;

  -- Same columns on both sides, or the rows would not fit.
  FOR t, x IN SELECT key, value FROM jsonb_each(b->'columns') LOOP
    IF (SELECT array_agg(column_name::text ORDER BY column_name::text COLLATE "C") FROM information_schema.columns
        WHERE table_schema = 'public' AND table_name = t)
       IS DISTINCT FROM
       (SELECT array_agg(c ORDER BY c COLLATE "C") FROM unnest(string_to_array(x #>> '{}', ',')) c) THEN
      RAISE EXCEPTION 'Table % has different columns on test and production: migrate both to the same release first. Nothing was changed.', t;
    END IF;
  END LOOP;

  INSERT INTO cs_seq (kind, next)
    SELECT 'reg', last_value + CASE WHEN is_called THEN 1 ELSE 0 END FROM shop_registration_seq
    UNION ALL SELECT 'code', last_value + CASE WHEN is_called THEN 1 ELSE 0 END FROM product_code_seq;

  BEGIN
    PERFORM pg_temp.cs_say(CASE WHEN apply THEN 'COPY SHOPS TO PRODUCTION: SAVED' ELSE 'COPY SHOPS TO PRODUCTION: PREVIEW, nothing was saved' END);
    PERFORM pg_temp.cs_say(format('Database %s · test export of %s · shops %s', current_database(), b->>'exportedAt',
      (SELECT string_agg(v, ', ') FROM jsonb_array_elements_text(b->'shops') v)));

    FOR s IN SELECT e FROM pg_temp.cs_rows('shops') e ORDER BY e->>'registration_number' LOOP
      PERFORM pg_temp.cs_say('');
      PERFORM pg_temp.cs_say(format('%s (test %s, %s, %s)', s->>'name', s->>'registration_number', s->>'status',
        concat_ws(' ', s->>'area', s->>'city', s->>'pincode')));
      IF EXISTS (SELECT 1 FROM shops WHERE id::text = s->>'id') THEN
        PERFORM pg_temp.cs_bump('skipped');
        PERFORM pg_temp.cs_say('  - already on production (same shop id): skipped');
        CONTINUE;
      END IF;
      t := NULL;
      SELECT format('%s (%s)', name, registration_number) INTO t FROM shops
        WHERE lower(trim(name)) = lower(trim(s->>'name')) AND pincode = s->>'pincode' AND deleted_at IS NULL LIMIT 1;
      IF t IS NOT NULL THEN
        PERFORM pg_temp.cs_bump('skipped');
        PERFORM pg_temp.cs_say(format('  - production already has %s in %s: skipped, to avoid a duplicate', t, s->>'pincode'));
        CONTINUE;
      END IF;
      IF s->>'shop_act_key' IS NOT NULL AND EXISTS (SELECT 1 FROM shops WHERE shop_act_key = s->>'shop_act_key' AND deleted_at IS NULL) THEN
        PERFORM pg_temp.cs_bump('skipped');
        PERFORM pg_temp.cs_say('  - production already has a shop with the same Shop Act registration: skipped, to avoid a duplicate');
        CONTINUE;
      END IF;

      v_owner := pg_temp.cs_owner(s->>'owner_id');
      reg := 'BKS-' || lpad(pg_temp.cs_next('reg', apply)::text, 6, '0');
      slug_v := s->>'slug';
      t2 := '';
      IF EXISTS (SELECT 1 FROM shops WHERE slug = slug_v) THEN
        slug_v := slug_v || '-' || substr(md5(random()::text), 1, 6);
        t2 := ' (web address changed: the old one is taken)';
      END IF;
      SELECT coalesce(jsonb_agg(k2), '[]'::jsonb) INTO photos FROM (
        SELECT pg_temp.cs_url(p) AS k2 FROM jsonb_array_elements_text(
          CASE WHEN jsonb_typeof(s->'photos') = 'array' THEN s->'photos' ELSE '[]'::jsonb END) p) z
      WHERE k2 IS NOT NULL;

      INSERT INTO shops SELECT * FROM jsonb_populate_record(NULL::shops, s || jsonb_build_object(
        'owner_id', v_owner, 'registration_number', reg, 'slug', slug_v,
        'logo_url', pg_temp.cs_url(s->>'logo_url'), 'photos', photos,
        -- Test-only records production does not have.
        'approved_by', NULL, 'shop_registration_id', NULL, 'registration_tier_id', NULL, 'registration_fee_id', NULL,
        'referral_code_id', NULL, 'status_actor_id', NULL, 'turnover_declared_by', NULL, 'gst_verified_by', NULL,
        'pan_verified_by', NULL,
        -- Encrypted with the test site's key: unreadable on production. The last four digits stay.
        'pan_number_encrypted', NULL, 'pan_hash', NULL));
      PERFORM pg_temp.cs_say(format('  - shop added as %s%s; status %s%s', reg, t2, s->>'status',
        CASE WHEN coalesce(s->>'latitude', '') <> '' THEN ', map location kept' ELSE ', no map location' END));

      -- Shop categories (the kind of shop), matched by id, slug or name.
      FOR x IN SELECT e FROM pg_temp.cs_rows('shop_category_mapping') e WHERE e->>'shop_id' = s->>'id' LOOP
        y := pg_temp.cs_row('shop_categories', x->>'category_id');
        IF y IS NULL THEN RAISE EXCEPTION 'Shop category % is missing from the export.', x->>'category_id'; END IF;
        t := NULL;
        SELECT id::text INTO t FROM shop_categories WHERE id::text = y->>'id';
        IF t IS NULL THEN SELECT id::text INTO t FROM shop_categories WHERE slug = y->>'slug'; END IF;
        IF t IS NULL THEN SELECT id::text INTO t FROM shop_categories WHERE lower(name) = lower(y->>'name'); END IF;
        IF t IS NULL THEN
          INSERT INTO shop_categories SELECT * FROM jsonb_populate_record(NULL::shop_categories, y);
          t := y->>'id';
          PERFORM pg_temp.cs_bump('categories');
        END IF;
        INSERT INTO shop_category_mapping SELECT * FROM jsonb_populate_record(NULL::shop_category_mapping,
          x || jsonb_build_object('category_id', t));
      END LOOP;

      -- Listings: price, stock and sale settings; the catalogue product matched or added first.
      n_list := 0; n_new := 0;
      FOR x IN SELECT e FROM pg_temp.cs_rows('shop_products') e WHERE e->>'shop_id' = s->>'id' LOOP
        t := pg_temp.cs_product(x->>'product_id', apply);
        IF (SELECT added FROM cs_map WHERE kind = 'product' AND src = x->>'product_id') THEN n_new := n_new + 1; END IF;
        INSERT INTO shop_products SELECT * FROM jsonb_populate_record(NULL::shop_products, x || jsonb_build_object(
          'product_id', t, 'image_url', pg_temp.cs_url(x->>'image_url'), 'content_updated_by', NULL));
        n_list := n_list + 1;
      END LOOP;
      PERFORM pg_temp.cs_bump('listings', n_list);

      -- A listing's own photos.
      n_photos := 0;
      FOR x IN SELECT e FROM pg_temp.cs_rows('product_images') e
               WHERE e->>'shop_product_id' IN (SELECT l->>'id' FROM pg_temp.cs_rows('shop_products') l WHERE l->>'shop_id' = s->>'id') LOOP
        IF pg_temp.cs_photo(x) THEN n_photos := n_photos + 1; END IF;
      END LOOP;

      -- The product categories the shop chose to sell in.
      n_chosen := 0;
      FOR x IN SELECT e FROM pg_temp.cs_rows('shop_product_categories') e WHERE e->>'shop_id' = s->>'id' LOOP
        INSERT INTO shop_product_categories SELECT * FROM jsonb_populate_record(NULL::shop_product_categories,
          x || jsonb_build_object('category_id', pg_temp.cs_pcat(x->>'category_id'), 'added_by', NULL))
        ON CONFLICT DO NOTHING;
        GET DIAGNOSTICS n_rows = ROW_COUNT;
        n_chosen := n_chosen + n_rows;
      END LOOP;

      INSERT INTO audit_logs SELECT * FROM jsonb_populate_record(NULL::audit_logs, jsonb_build_object(
        'id', gen_random_uuid(), 'action', 'shop.copied_from_test', 'entity_type', 'shop', 'entity_id', s->>'id',
        'new_value', jsonb_build_object('from', 'test.gokesari.com', 'testRegistrationNumber', s->>'registration_number',
          'registrationNumber', reg, 'listings', n_list),
        'user_agent', 'copy-shops SQL (Neon console)', 'created_at', now()));

      PERFORM pg_temp.cs_bump('shops');
      PERFORM pg_temp.cs_say(format('  - %s listing(s) with prices and stock (%s on products new to production''s catalogue), %s listing photo(s), %s product categor%s',
        n_list, n_new, n_photos, n_chosen, CASE WHEN n_chosen = 1 THEN 'y' ELSE 'ies' END));
    END LOOP;

    PERFORM pg_temp.cs_say('');
    PERFORM pg_temp.cs_say('TOTALS');
    PERFORM pg_temp.cs_say(format('  Shops copied: %s · skipped (already on production): %s',
      pg_temp.cs_count('shops'), pg_temp.cs_count('skipped')));
    PERFORM pg_temp.cs_say(format('  Owner accounts created: %s · matched to existing: %s',
      pg_temp.cs_count('new_owners'), pg_temp.cs_count('existing_owners')));
    PERFORM pg_temp.cs_say(format('  Listings: %s · catalogue products added: %s · matched to existing: %s',
      pg_temp.cs_count('listings'), pg_temp.cs_count('new_products'),
      pg_temp.cs_count('matched_products')));
    PERFORM pg_temp.cs_say(format('  Categories added: %s · photos copied: %s · photos not available: %s',
      pg_temp.cs_count('categories'), pg_temp.cs_count('images'),
      (SELECT count(*) FROM cs_missing)));
    PERFORM pg_temp.cs_say(CASE WHEN apply
      THEN 'Saved to production.'
      ELSE 'PREVIEW only: production was not changed. If this is right, run the APPLY file.' END);

    rep := ARRAY(SELECT line FROM cs_log ORDER BY n);
    IF NOT apply THEN RAISE EXCEPTION 'cs_preview_rollback'; END IF;
  EXCEPTION WHEN raise_exception THEN
    IF SQLERRM <> 'cs_preview_rollback' THEN RAISE; END IF;
  END;

  TRUNCATE cs_report;
  INSERT INTO cs_report (line) SELECT unnest(rep);
END $cs_body$;

SELECT line AS "Copy shops to production" FROM cs_report ORDER BY n;
