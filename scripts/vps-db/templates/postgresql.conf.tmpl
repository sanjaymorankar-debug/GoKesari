# GoKesari: @GK_ENV@ instance (cluster @PG_MAJOR@/@CLUSTER@). Written by
# scripts/vps-db/30-postgres.sh from templates/postgresql.conf.tmpl; edits here
# are overwritten. Plan §4.2–4.3.

listen_addresses = '*'                  # who may connect: access.sh (ufw + pg_hba)
port = @PORT@
max_connections = @MAX_CONNECTIONS@
superuser_reserved_connections = 3

# Must match Neon, so the app behaves the same
timezone = 'GMT'
log_timezone = 'Asia/Kolkata'
datestyle = 'iso, mdy'
default_transaction_isolation = 'read committed'
idle_in_transaction_session_timeout = '5min'
statement_timeout = 0
shared_preload_libraries = 'pg_stat_statements'

# Memory and disk
shared_buffers = @SHARED_BUFFERS@
effective_cache_size = @EFFECTIVE_CACHE_SIZE@
work_mem = @WORK_MEM@
maintenance_work_mem = @MAINTENANCE_WORK_MEM@
random_page_cost = 1.1
effective_io_concurrency = 200
temp_file_limit = @TEMP_FILE_LIMIT@

# WAL, checkpoints and archiving to pgBackRest (plan §5.1)
wal_level = replica
wal_compression = zstd
max_wal_size = 2GB
min_wal_size = 256MB
checkpoint_completion_target = 0.9
archive_mode = on
archive_command = 'pgbackrest --stanza=@STANZA@ archive-push %p'
archive_timeout = @ARCHIVE_TIMEOUT@

# Connections and TLS (plan §4.6)
password_encryption = 'scram-sha-256'
ssl = on
ssl_cert_file = '@PGCONF@/tls/server.crt'
ssl_key_file = '@PGCONF@/tls/server.key'
ssl_min_protocol_version = 'TLSv1.2'
tcp_keepalives_idle = 60
tcp_keepalives_interval = 10
tcp_keepalives_count = 6

# Logging. Connections are logged for the first 30 days after the cut-over
# (plan §4.3); then set log_connections = off here and in the template.
log_line_prefix = '%m [%p] %q%u@%d %h '
log_min_duration_statement = 500ms
log_lock_waits = on
log_connections = on
log_temp_files = 10MB
