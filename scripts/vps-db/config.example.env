# GoKesari database server settings. On the VPS this file is
# /etc/gokesari-db/config.env (RUNBOOK.md Part 1, step 4). Fill in the blanks.
#
# NO SECRETS IN THIS FILE. Passwords and keys are made or typed on the server
# with `gk-db-secret` and kept in /etc/gokesari-db/secrets (root only); the
# owner keeps a copy in the password manager. Public keys are not secrets.

# The VPS's public IPv4 address, from hPanel after the purchase (gate G1).
VPS_PUBLIC_IP=""

# Host names (plan §4.2). DNS A records point both at VPS_PUBLIC_IP.
DB_HOST_PROD="db.gokesari.com"
DB_HOST_TEST="db-test.gokesari.com"

# Database and role names (decision 6, the recommended names).
PROD_DB="gokesari"
TEST_DB="gokesari_test"
PROD_APP_ROLE="gokesari_app"
TEST_APP_ROLE="gokesari_test_app"
PROD_RO_ROLE="gokesari_ro"
TEST_RO_ROLE="gokesari_test_ro"

# Outgoing IPv4 address(es) of the Hostinger app servers, space-separated
# (plan step B2). gokesari.com's go in PROD, test.gokesari.com's in STAGING.
# Empty: no app server can reach that database yet.
APP_IPS_PROD=""
APP_IPS_STAGING=""

# SSH: "public" while building; 90-lockdown.sh sets "wg" (SSH only over WireGuard).
SSH_MODE="public"

# Admin login: user name, and the PUBLIC key made on the owner's Mac by
# scripts/vps-db/mac/make-admin-key.sh (one line, starting "ssh-ed25519").
ADMIN_USER="gkadmin"
ADMIN_SSH_PUBKEY=""

# Let's Encrypt account e-mail for certificate expiry notices. Empty: none.
LETSENCRYPT_EMAIL=""

# Cloudflare R2 (decision 3): account id (from the R2 dashboard) and bucket.
# The R2 keys are not here: the owner types them into `gk-db-secret set-r2`.
# Empty R2_ACCOUNT_ID = no off-site copy: every backup stays on this server
# (decision 3 since 16-Nov-2026, "VPS only"). To add R2 later: set it, run
# set-r2 and cipher, then re-run 60-pgbackrest.sh (RUNBOOK "Adding R2 later").
R2_ACCOUNT_ID=""
R2_BUCKET="gokesari-db-backups"

# Nightly dumps are encrypted for this age PUBLIC key ("age1…"). Its private
# key is only in the owner's password manager and on the Mac (plan §5.1).
DUMP_AGE_RECIPIENT=""

# Alerts: DECISION 5 IS OPEN. healthchecks.io sends the alerts; where they go
# (e-mail and/or Telegram) is set in healthchecks.io. Note it here once decided.
ALERT_DESTINATION="<decision 5: not decided yet>"

# Set to "yes" after each cut-over. The health check then warns when no app
# connection has come in for 15 minutes (for example, a changed Hostinger IP).
APP_LIVE_PROD="no"
APP_LIVE_STAGING="no"
