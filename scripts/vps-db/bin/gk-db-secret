#!/usr/bin/env bash
# The server's passwords and keys, kept in /etc/gokesari-db/secrets (root only).
# Nothing here is ever in the repository, and nothing is printed unless asked
# by name. To give one to the owner, pipe it straight to the Mac's clipboard
# (mac/copy-secret.sh); never paste one into a chat.
#
#   gk-db-secret list                       which secrets are set (never their values)
#   gk-db-secret gen <name>                 make a 40-character password, if none exists
#   gk-db-secret show <name>                print one value
#   gk-db-secret url <prod|staging> [app|ro]  print that role's connection URL
#   gk-db-secret set-r2                     type the R2 write key (input hidden)
#   gk-db-secret set-healthchecks           type the healthchecks.io ping key (input hidden)
#   gk-db-secret cipher                     make the pgBackRest encryption passphrase, if none exists
#
# Names: the role names (gokesari_app, …), r2-access-key-id, r2-secret-access-key,
# pgbackrest-cipher-pass, hc-ping-key.
. "${GK_KIT:-/opt/gokesari-db}/lib.sh"
need_root
umask 077
install -d -m 700 "$GK_SECRETS"

valid_name() { [[ "$1" =~ ^[a-z0-9_-]{1,64}$ ]] || die "Bad secret name '$1'."; }

write_secret() { # write_secret <name> <value>
  local tmp
  tmp=$(mktemp "$GK_SECRETS/.tmp.XXXXXX")
  printf '%s\n' "$2" > "$tmp"
  mv "$tmp" "$(secret_file "$1")"
}

ask() { # ask <prompt> -> value on stdout; input hidden
  local v
  [ -t 0 ] || die "This needs a terminal to type into (ssh -t …)."
  read -rs -p "$1: " v; echo >&2
  v=$(printf '%s' "$v" | tr -d '[:space:]')
  [ -n "$v" ] || die "Nothing typed."
  printf '%s' "$v"
}

# pgBackRest reads conf.d/*.conf; this one holds repo2's keys and passphrase.
sync_pgbackrest() {
  [ -d /etc/pgbackrest ] || return 0
  install -d -m 750 -o root -g postgres /etc/pgbackrest/conf.d
  local tmp
  tmp=$(mktemp)
  {
    echo "# Written by gk-db-secret. Never copy this file anywhere."
    echo "[global]"
    if r2_enabled; then
      if has_secret r2-access-key-id; then echo "repo2-s3-key=$(read_secret r2-access-key-id)"; fi
      if has_secret r2-secret-access-key; then echo "repo2-s3-key-secret=$(read_secret r2-secret-access-key)"; fi
      if has_secret pgbackrest-cipher-pass; then echo "repo2-cipher-pass=$(read_secret pgbackrest-cipher-pass)"; fi
    fi
  } > "$tmp"
  install -m 640 -o root -g postgres "$tmp" "$PGBR_SECRETS"
  rm -f "$tmp"
}

new_password() { local p; p=$(openssl rand -base64 64 | tr -dc 'A-Za-z0-9'); printf '%s' "${p:0:40}"; }

cmd=${1:-list}
case "$cmd" in
  list)
    for f in "$GK_SECRETS"/*; do
      [ -e "$f" ] || { echo "(none yet)"; break; }
      printf '%-28s set %s\n' "$(basename "$f")" "$(TZ=Asia/Kolkata date -r "$f" '+%d-%b-%Y %H.%M IST')"
    done ;;
  gen)
    valid_name "${2:-}"
    if has_secret "$2"; then log "$2 already exists; kept."; else write_secret "$2" "$(new_password)"; log "$2 made (40 characters)."; fi ;;
  show)
    valid_name "${2:-}"
    read_secret "$2"; echo ;;
  url)
    use_env "${2:-}"
    case "${3:-app}" in app) role=$APP_ROLE ;; ro) role=$RO_ROLE ;; *) die "Role must be app or ro." ;; esac
    # sslmode=verify-full once the app supports it (plan §7 A4); require until then.
    printf 'postgresql://%s:%s@%s:%s/%s?sslmode=require\n' "$role" "$(read_secret "$role")" "$DB_HOSTNAME" "$PORT" "$DB" ;;
  set-r2)
    id=$(ask "R2 access key ID (write key)")
    key=$(ask "R2 secret access key")
    write_secret r2-access-key-id "$id"
    write_secret r2-secret-access-key "$key"
    sync_pgbackrest
    log "R2 write key saved (not shown). Test it with: sudo gk-db-backup check" ;;
  set-healthchecks)
    write_secret hc-ping-key "$(ask "healthchecks.io project ping key")"
    log "Ping key saved (not shown)."
    hc_ping gk-setup ok "Ping key set on $(hostname) at $(ist)" ;;
  cipher)
    if has_secret pgbackrest-cipher-pass; then
      log "The pgBackRest passphrase already exists; kept. Changing it would make the R2 backups unreadable."
    else
      write_secret pgbackrest-cipher-pass "$(openssl rand -base64 48 | tr -d '\n')"
      log "pgBackRest passphrase made. Copy it to the password manager NOW (mac/copy-secret.sh pgbackrest-cipher-pass): without it the R2 backups cannot be read."
    fi
    sync_pgbackrest ;;
  sync) sync_pgbackrest ;;
  *) die "Unknown command '$cmd'. See the top of $0." ;;
esac
