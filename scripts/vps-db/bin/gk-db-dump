#!/usr/bin/env bash
# Nightly pg_dump of one database (plan §5.1, layer 2). Run as root; the
# timers run it nightly (70-schedules.sh).
#
#   gk-db-dump <prod|staging>
#
# Keeps on this disk: the plain dump and its age-encrypted copy, 7 days
# (staging 14). Uploads the encrypted copy to R2: dumps/<env>/daily/ 35 days
# (staging 14); on the 1st of the month also dumps/prod/monthly/, 12 months.
# The key that opens the encrypted copies is NOT on this server.
. "${GK_KIT:-/opt/gokesari-db}/lib.sh"
need_root
need_config DUMP_AGE_RECIPIENT R2_ACCOUNT_ID R2_BUCKET
use_env "${1:-}"

slug=gk-dump-$GK_ENV
hc_ping "$slug" start
trap 'hc_ping "$slug" fail "Dump of $GK_ENV failed at $(ist). journalctl -u gk-db-dump-$GK_ENV"' ERR

dir=$GK_STATE/dumps/$GK_ENV
install -d -m 700 "$dir"
name="$GK_ENV-$(date +%F)"
if [ "$GK_ENV" = prod ]; then keep_local=7; keep_r2=35; else keep_local=14; keep_r2=14; fi

# The dump directory is root's; postgres writes to stdout and root saves it.
runuser -u postgres -- "$PG_BIN/pg_dump" -h "$PG_SOCKET" -p "$PORT" -Fc --compress=zstd:6 "$DB" > "$dir/.$name.dump.part"
mv "$dir/.$name.dump.part" "$dir/$name.dump"
objects=$("$PG_BIN/pg_restore" --list "$dir/$name.dump" | grep -cv '^;')
age -r "$DUMP_AGE_RECIPIENT" -o "$dir/$name.dump.age" "$dir/$name.dump"
size=$(du -h "$dir/$name.dump.age" | cut -f1)

# rclone reads the remote from the environment: nothing is written to disk.
export RCLONE_CONFIG_R2_TYPE=s3 RCLONE_CONFIG_R2_PROVIDER=Cloudflare RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
export RCLONE_CONFIG_R2_ENDPOINT="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
RCLONE_CONFIG_R2_ACCESS_KEY_ID=$(read_secret r2-access-key-id); export RCLONE_CONFIG_R2_ACCESS_KEY_ID
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=$(read_secret r2-secret-access-key); export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY
base="r2:$R2_BUCKET/dumps/$GK_ENV"
rclone copyto "$dir/$name.dump.age" "$base/daily/$name.dump.age"
if [ "$GK_ENV" = prod ] && [ "$(date +%d)" = 01 ]; then
  rclone copyto "$dir/$name.dump.age" "$base/monthly/$name.dump.age"
  rclone delete --min-age 365d "$base/monthly"
fi
rclone delete --min-age "${keep_r2}d" "$base/daily"
find "$dir" -maxdepth 1 -name "$GK_ENV-*.dump*" -mtime +"$keep_local" -delete

trap - ERR
log "$GK_ENV dump: $name.dump ($objects objects), encrypted copy $size uploaded to R2."
hc_ping "$slug" ok "$name: $objects objects, $size encrypted, in R2 at $(ist)"
